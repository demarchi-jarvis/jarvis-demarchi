<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080">
  <title>Instagram Card</title>
  <style>
    /* ── Montserrat embarcada (variable font, sem dependência de rede) ── */
    {{ font_css | safe }}

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    body {
      width: 1080px;
      height: 1350px;
      overflow: hidden;
      background: #000;
      font-family: 'Montserrat', 'Inter', Arial, sans-serif;
    }

    /* ══════════════════════════════════════════════
       CARD  —  1080 × 1350 px
    ══════════════════════════════════════════════ */
    .card {
      width: 1080px;
      height: 1350px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    /* ──────────────────────────────────────────────
       HEADER  ·  55%  →  742 px
    ────────────────────────────────────────────── */
    .header {
      position: relative;
      width: 1080px;
      height: 742px;
      flex-shrink: 0;
      overflow: hidden;
    }

    .header__photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
    }

    /* Gradiente cinematográfico: longo, suave, 100% preto na base */
    .header__gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        transparent        0%,
        transparent        20%,
        rgba(0,0,0,0.20)   40%,
        rgba(0,0,0,0.65)   68%,
        rgba(0,0,0,0.92)   85%,
        #000000           100%
      );
    }

    /* ──────────────────────────────────────────────
       BODY  ·  45%  →  608 px
    ────────────────────────────────────────────── */
    .body {
      position: relative;
      flex: 1;
      background: #000000;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 40px 80px 68px 80px;
      overflow: hidden;
    }

    /* ── Conteúdo ── */
    .content {
      display: flex;
      flex-direction: column;
      gap: 22px;
      flex: 1;
      min-height: 0;
    }

    /* Tag / pílula */
    .tag {
      display: inline-flex;
      align-items: center;
      background: #1A4A8E;
      color: #FFFFFF;
      font-family: 'Montserrat', Arial, sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      padding: 10px 26px;
      border-radius: 100px;
      width: fit-content;
      flex-shrink: 0;
      line-height: 1;
    }

    /* Título — ExtraBold, laranja */
    .title {
      font-family: 'Montserrat', Arial, sans-serif;
      font-size: 58px;
      font-weight: 800;
      color: #D35400;
      line-height: 1.15;
      text-align: left;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    /* Subtítulo — Regular, branco 90% */
    .subtitle {
      font-family: 'Montserrat', Arial, sans-serif;
      font-size: 27px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.90);
      line-height: 1.58;
      text-align: left;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    /* ── Footer ── */
    .footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      padding-top: 32px;
    }

    /* Botão @handle — outline branco */
    .handle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 2px solid rgba(255, 255, 255, 0.85);
      color: #FFFFFF;
      font-family: 'Montserrat', Arial, sans-serif;
      font-size: 23px;
      font-weight: 600;
      letter-spacing: 0.3px;
      padding: 13px 34px;
      border-radius: 100px;
      background: transparent;
      white-space: nowrap;
    }

    /* ── Carousel: dots ── */
    .dots {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .dot {
      height: 14px;
      width: 14px;
      border-radius: 100px;
      background: rgba(255, 255, 255, 0.32);
      flex-shrink: 0;
    }

    .dot--active {
      width: 46px;
      background: #FFFFFF;
    }

    /* ── Carousel: seta lateral ── */
    .arrow {
      position: absolute;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.14);
      border: 2.5px solid rgba(255, 255, 255, 0.65);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-size: 38px;
      font-weight: 700;
      line-height: 1;
      padding-left: 4px;
    }
  </style>
</head>
<body>
  <div class="card">

    <!-- HEADER -->
    <div class="header">
      <img class="header__photo" src="{{ photo_data }}" alt="">
      <div class="header__gradient"></div>
    </div>

    <!-- BODY -->
    <div class="body">

      <div class="content">
        <span class="tag">{{ tag }}</span>
        <h1 class="title">{{ title }}</h1>
        <p class="subtitle">{{ subtitle }}</p>
      </div>

      <div class="footer">
        <span class="handle">@{{ handle }}</span>

        {% if is_carousel %}
        <div class="dots">
          {% for i in range(1, total_pages + 1) %}
          <div class="dot{% if i == page_number %} dot--active{% endif %}"></div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      {% if show_arrow %}
      <div class="arrow">&#8250;</div>
      {% endif %}

    </div><!-- /body -->
  </div><!-- /card -->
</body>
</html>
