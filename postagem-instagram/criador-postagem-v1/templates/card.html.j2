<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080">
  <title>Instagram Card</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    /* ── Reset ── */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      width: 1080px;
      height: 1350px;
      overflow: hidden;
      font-family: 'Montserrat', 'Inter', Arial, sans-serif;
      background: #000;
    }

    /* ── Card wrapper ── */
    .card {
      width: 1080px;
      height: 1350px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ══════════════════════════════════════
       HEADER  —  55%  →  742 px
    ══════════════════════════════════════ */
    .card__header {
      position: relative;
      width: 1080px;
      height: 742px;
      flex-shrink: 0;
      overflow: hidden;
    }

    .card__header img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Gradiente fade-to-black na base da foto */
    .card__gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        transparent        30%,
        rgba(0, 0, 0, 0.55) 62%,
        #000000            100%
      );
      pointer-events: none;
    }

    /* ══════════════════════════════════════
       BODY  —  45%  →  608 px
    ══════════════════════════════════════ */
    .card__body {
      position: relative;
      flex: 1;                       /* ocupa o restante exato */
      background: #000000;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 36px 80px 72px 80px;
      overflow: hidden;
    }

    /* ── Conteúdo (tag + título + subtítulo) ── */
    .card__content {
      display: flex;
      flex-direction: column;
      gap: 20px;
      flex: 1;
      min-height: 0;
    }

    .card__tag {
      display: inline-flex;
      align-items: center;
      background: #1A4A8E;
      color: #FFFFFF;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 9px 24px;
      border-radius: 100px;
      width: fit-content;
      flex-shrink: 0;
    }

    .card__title {
      font-size: 54px;
      font-weight: 800;
      color: #D35400;
      line-height: 1.18;
      text-align: left;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    .card__subtitle {
      font-size: 26px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.90);
      line-height: 1.55;
      text-align: left;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    /* ── Footer (handle + dots) ── */
    .card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      padding-top: 28px;
    }

    /* Botão @handle — outline branco */
    .card__handle {
      display: inline-flex;
      align-items: center;
      border: 2px solid #FFFFFF;
      color: #FFFFFF;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: 0.5px;
      padding: 12px 32px;
      border-radius: 100px;
      background: transparent;
    }

    /* ── Dots indicadores de carrossel ── */
    .card__dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dot {
      height: 8px;
      width: 8px;
      border-radius: 100px;
      background: rgba(255, 255, 255, 0.28);
    }

    .dot--active {
      width: 26px;
      background: #FFFFFF;
    }

    /* ── Seta lateral (próxima página) ── */
    .card__arrow {
      position: absolute;
      right: 28px;
      top: 50%;
      transform: translateY(-50%);
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.10);
      border: 1.5px solid rgba(255, 255, 255, 0.50);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-size: 28px;
      font-weight: 700;
      line-height: 1;
    }
  </style>
</head>
<body>
  <div class="card">

    <!-- ── HEADER ── -->
    <div class="card__header">
      <img src="{{ photo_data }}" alt="">
      <div class="card__gradient"></div>
    </div>

    <!-- ── BODY ── -->
    <div class="card__body">

      <div class="card__content">
        <span class="card__tag">{{ tag }}</span>
        <h1 class="card__title">{{ title }}</h1>
        <p class="card__subtitle">{{ subtitle }}</p>
      </div>

      <div class="card__footer">
        <span class="card__handle">@{{ handle }}</span>

        {% if is_carousel %}
        <div class="card__dots">
          {% for i in range(1, total_pages + 1) %}
          <div class="dot{% if i == page_number %} dot--active{% endif %}"></div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      {% if show_arrow %}
      <div class="card__arrow">&#8250;</div>
      {% endif %}

    </div><!-- /body -->
  </div><!-- /card -->
</body>
</html>
